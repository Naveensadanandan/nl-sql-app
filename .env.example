# LLM
ANTHROPIC_API_KEY=
NLSQL_FAST_MODEL=claude-haiku-5-5
NLSQL_STRONG_MODEL=claude-sonnet-5-5

# Observability / evals
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=nlsql-dev

# Infra (matches docker-compose.yml)
NLSQL_APP_DB_URL=postgresql://nlsql:nlsql@localhost:5432/nlsql
NLSQL_ES_URL=http://localhost:9200
NLSQL_QDRANT_URL=http://localhost:6333
NLSQL_REDIS_URL=redis://localhost:6379/0

# Fernet key for encrypting user DB credentials:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
NLSQL_FERNET_KEY=

# Optional: higher rate limits for the Context7 MCP server (Claude Code reads this from your shell env)
CONTEXT7_API_KEY=
