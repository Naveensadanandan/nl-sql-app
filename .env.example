# LLM (all calls go through OpenRouter; model values must be OpenRouter slugs, provider/model)
NLSQL_OPENROUTER_API_KEY=
NLSQL_FAST_MODEL=claude-haiku-5-5
NLSQL_STRONG_MODEL=claude-sonnet-5-5
NLSQL_LLM_TIMEOUT_SECONDS=60
NLSQL_LLM_MAX_RETRIES=2

# Observability / evals
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=nlsql-dev

# Infra (matches docker-compose.yml)
# Plain postgresql:// form; the app adds the +psycopg driver for SQLAlchemy itself.
# Host port 5433 and user/db "nlsql" match docker-compose.yml; use your POSTGRES_PASSWORD.
NLSQL_DATABASE_URL=postgresql://nlsql:change-me@localhost:5433/nlsql
# Query store WRITES (query_log + result tables). Use a separate role from the read-only one above;
# unset = reuse NLSQL_DATABASE_URL (the API logs a warning at startup).
NLSQL_RESULTS_DATABASE_URL=

# Data the agent may query (v0.1: one schema, fixed table list, JSON list)
NLSQL_DATA_SCHEMA=public
NLSQL_DATA_TABLES=["retail_sales"]
NLSQL_SCHEMA_CACHE_TTL_SECONDS=300

# Admin server (uvicorn nlsql.admin.main:app --port 8001); every call needs X-Admin-Key
NLSQL_ADMIN_API_KEY=
NLSQL_ES_URL=http://localhost:9200
NLSQL_QDRANT_URL=http://localhost:6333
NLSQL_REDIS_URL=redis://localhost:6379/0  # not used by v0.1 code yet

POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Fernet key for encrypting user DB credentials (not used by v0.1 code yet):
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
NLSQL_FERNET_KEY=

# Optional: higher rate limits for the Context7 MCP server (Claude Code reads this from your shell env)
CONTEXT7_API_KEY=
